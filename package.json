{
  "name": "openvdb-workspace",
  "version": "0.6.0",
  "private": true,
  "description": "OpenVDB for JavaScript: openvdb (core), three-openvdb (three.js rendering and .wvdb loaders), webvdb (CLI).",
  "workspaces": [
    "src/openvdb",
    "src/three-openvdb",
    "src/wvdb",
    "src/docs/examples"
  ],
  "scripts": {
    "build": "npm run build -w openvdb -w three-openvdb -w webvdb",
    "bake:examples": "node ./build/webvdb/cli.mjs src/docs/examples/public/assets/bunny_cloud.vdb && node ./build/webvdb/cli.mjs src/docs/examples/public/assets/venusstatue.vdb && node ./build/webvdb/cli.mjs src/docs/examples/public/assets/utahteapot.vdb && node ./build/webvdb/cli.mjs src/docs/examples/public/assets/smoke.vdb",
    "build:examples": "npm run build -w openvdb-examples",
    "dev": "npm run dev -w openvdb-examples",
    "release": "npm run build && npm publish ./build/openvdb && npm publish ./build/three-openvdb && npm publish ./build/webvdb"
  },
  "author": {
    "name": "mjurczyk",
    "url": "https://discourse.threejs.org/u/mjurczyk"
  },
  "contributors": [
    {
      "name": "mjurczyk",
      "url": "https://discourse.threejs.org/u/mjurczyk"
    },
    {
      "name": "notchris",
      "url": "https://discourse.threejs.org/u/notchris"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@lopatnov/rollup-plugin-uglify": "^2.1.5",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "rollup": "^2.79.1",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-delete": "^2.0.0",
    "stats.js": "^0.17.0"
  }
}
